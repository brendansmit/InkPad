[Unit]
Description=AI Control phone dashboard
After=network.target

[Service]
Type=simple
User=ai-control
Group=ai-control
WorkingDirectory=/opt/ai-control
Environment=AI_CONTROL_HOME=/opt/ai-control
Environment=AI_CONTROL_HOST=127.0.0.1
Environment=AI_CONTROL_PORT=8099
Environment=AI_CONTROL_COOKIE_SECURE=1
EnvironmentFile=/etc/ai-control.env
ExecStart=/usr/bin/python3 /opt/ai-control/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ai-control
ReadWritePaths=/home/ai-control

[Install]
WantedBy=multi-user.target
