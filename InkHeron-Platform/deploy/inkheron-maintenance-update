#!/usr/bin/env bash
set -u

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV_FILE=/etc/inkheron/serverchan.env
LOG_FILE=/var/log/inkheron-maintenance-update.log
LOCK_FILE=/run/inkheron-maintenance-update.lock
RETRY_FILE=/var/lib/inkheron-maintenance/retry-next-window
UPDATE_TIMEOUT=45m

mkdir -p /var/lib/inkheron-maintenance
source "$ENV_FILE"

log() {
  printf "%s %s\n" "$(date -Is)" "$*" | tee -a "$LOG_FILE"
}

alert() {
  local title="$1"
  local body="$2"
  if [ -n "${SERVERCHAN_SENDKEY:-}" ]; then
    curl -fsS --max-time 20 "https://sctapi.ftqq.com/${SERVERCHAN_SENDKEY}.send" \
      --data-urlencode "title=${title}" \
      --data-urlencode "desp=${body}" >/dev/null 2>&1 || true
  fi
}

should_run_today() {
  local dow
  dow="$(date +%u)"
  if [ "$dow" = "3" ] || [ "$dow" = "7" ] || [ -f "$RETRY_FILE" ]; then
    return 0
  fi
  return 1
}

if ! should_run_today; then
  exit 0
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log "Another maintenance update is already running."
  alert "InkPad update skipped" "Another maintenance update is already running on $(hostname)."
  exit 0
fi

started_at="$(date -Is)"
retry_reason=""
if [ -f "$RETRY_FILE" ]; then
  retry_reason="Retry marker present: $(cat "$RETRY_FILE" 2>/dev/null || true)"
fi

load1="$(awk '{print $1}' /proc/loadavg)"
available_kb="$(awk '/MemAvailable/ {print $2}' /proc/meminfo)"
available_mb=$((available_kb / 1024))
load_int="${load1%.*}"
if [ "$available_mb" -lt 120 ] || [ "$load_int" -ge 3 ]; then
  reason="Server too busy for safe update. load=${load1}, available_memory=${available_mb}MB. Will retry next morning."
  echo "$reason" > "$RETRY_FILE"
  log "$reason"
  alert "InkPad update postponed" "$reason"
  exit 0
fi

log "Starting controlled update. ${retry_reason}"
alert "InkPad update started" "$(hostname) started controlled updates at ${started_at}. Load ${load1}, memory ${available_mb}MB."

set +e
timeout --signal=TERM --kill-after=5m "$UPDATE_TIMEOUT" ionice -c 3 nice -n 15 bash -c '
  set -e
  export DEBIAN_FRONTEND=noninteractive
  dpkg --configure -a
  apt-get -o DPkg::Lock::Timeout=300 update
  apt-get -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" upgrade
  apt-get -y -o DPkg::Lock::Timeout=300 autoremove
  apt-get clean
' >> "$LOG_FILE" 2>&1
status=$?
set -e

if [ "$status" -eq 0 ]; then
  rm -f "$RETRY_FILE"
  finished_at="$(date -Is)"
  log "Controlled update finished successfully."
  alert "InkPad update finished" "$(hostname) finished updates successfully at ${finished_at}."
  exit 0
fi

if [ "$status" -eq 124 ] || [ "$status" -eq 137 ]; then
  reason="Controlled update timed out after ${UPDATE_TIMEOUT}. Will retry next morning. status=${status}"
else
  reason="Controlled update failed. Will retry next morning. status=${status}"
fi
echo "$reason" > "$RETRY_FILE"
log "$reason"
alert "InkPad update failed" "$reason. Check ${LOG_FILE} on $(hostname)."
exit 1
